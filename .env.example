# 模型通道
# mock   = 离线规则模型，无需任何密钥（默认，开箱即跑）
# openai = 任意 OpenAI 兼容接口
LLM_PROVIDER=mock

# 以下是接入真实模型时用的，LLM_PROVIDER=openai 时才生效
# DeepSeek:  https://api.deepseek.com/v1        deepseek-chat
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4   glm-4-flash（有免费额度）
# 阿里百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# 本地Ollama: http://localhost:11434/v1         qwen2.5:7b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 检索：低于该余弦相似度视为「知识库未收录」，触发拒答
MIN_EVIDENCE_SCORE=0.09

# 数据集路径（仅重训模型 / 重新标定等级阈值时需要）
# 默认读 data/NEU_Seg；也可指向本机任意位置，例如：
# NEU_SEG_DIR=E:/NEU_Seg-main
NEU_SEG_DIR=
